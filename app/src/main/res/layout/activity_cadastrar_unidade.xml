<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutCadUsuario"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/senai_s" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:text="Cadastro de unidades"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="24dp"
                android:background="@drawable/bg_glass"
                android:elevation="8dp"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"
                    android:fontFamily="@font/neo_sans_medium"
                    android:text="Dados da nova unidade"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <EditText
                    android:id="@+id/nomeUnidade"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_glass"
                    android:hint="Nome da unidade *"
                    android:paddingHorizontal="20dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#88FFFFFF" />

                <AutoCompleteTextView
                    android:id="@+id/estado"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_glass"
                    android:hint="Estado *"
                    android:paddingHorizontal="20dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#88FFFFFF" />

                <AutoCompleteTextView
                    android:id="@+id/regiao"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_glass"
                    android:hint="Região *"
                    android:paddingHorizontal="20dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#88FFFFFF" />


                <AutoCompleteTextView
                    android:id="@+id/identificacao"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_input_glass"
                    android:hint="Identificação *"
                    android:paddingHorizontal="20dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#88FFFFFF" />

                <Button
                    android:id="@+id/btnSalvarUnidade"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#1B4F9B"
                    android:fontFamily="@font/neo_sans_bold_italic"
                    android:text="CADASTRAR UNIDADE"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="100dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_gradient"
        android:fillViewport="true"
        android:fitsSystemWindows="true">

        <include layout="@layout/layout_sidebar" />
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>