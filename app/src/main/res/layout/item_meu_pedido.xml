<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_input_glass"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:elevation="0dp">

    <TextView
        android:id="@+id/tvPedidoId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pedido #123"
        android:fontFamily="@font/neo_sans_bold_italic"
        android:textSize="18sp"
        android:textColor="#FFFFFF"/>

    <TextView
        android:id="@+id/tvPedidoProdutos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Produtos solicitados..."
        android:layout_marginTop="4dp"
        android:fontFamily="@font/neo_sans_regular"
        android:textSize="14sp"
        android:textColor="#E0E0E0"/>

    <TextView
        android:id="@+id/tvPedidoStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Status: Pendente"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:background="@drawable/bg_input_glass"
        android:textColor="#FF9800"
        android:fontFamily="@font/neo_sans_bold_italic"
        android:textSize="12sp"/>
</LinearLayout>
