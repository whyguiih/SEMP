<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_input_glass"
    android:padding="20dp"
    android:layout_marginBottom="16dp">

    <TextView
        android:id="@+id/tvPedidoId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/neo_sans_bold_italic"
        android:text="Pedido #123"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvPedidoProdutos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Produtos solicitados..."
        android:layout_marginTop="8dp"
        android:fontFamily="@font/neo_sans_regular"
        android:textSize="15sp"
        android:textColor="#E0E0E0"/>

    <TextView
        android:id="@+id/tvPedidoStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Status: Pendente"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@drawable/bg_input_glass"
        android:textColor="#FFD700"
        android:fontFamily="@font/neo_sans_bold_italic"
        android:textSize="14sp"/>
</LinearLayout>