<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#CCFFFFFF"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNomeEmprestimo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Solicitante"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/neo_sans_bold_italic"/>

        <TextView
            android:id="@+id/tvUnidadeEmprestimo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unidade"
            android:textColor="#333333"
            android:textSize="14sp"
            android:fontFamily="@font/neo_sans_medium"/>

        <TextView
            android:id="@+id/tvDataEmprestimo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data"
            android:textColor="#333333"
            android:textSize="14sp"
            android:fontFamily="@font/neo_sans_medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnAprovar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Aprovar"
                android:backgroundTint="#4CAF50"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/neo_sans_medium"/>

            <Button
                android:id="@+id/btnRecusar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recusar"
                android:backgroundTint="#F44336"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/neo_sans_medium"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>