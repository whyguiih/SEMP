<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_input_glass"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvNomeEmprestimo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome do Solicitante"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/neo_sans_bold_italic"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvUnidadeEmprestimo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Unidade"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/neo_sans_medium"/>

    <TextView
        android:id="@+id/tvDataEmprestimo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Data"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp"
        android:fontFamily="@font/neo_sans_medium"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAprovar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Aprovar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1a4b9f"
            android:layout_marginEnd="8dp"
            app:cornerRadius="12dp"
            android:fontFamily="@font/neo_sans_bold_italic"/>

        <Button
            android:id="@+id/btnRecusar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Recusar"
            android:textColor="#FFFFFF"
            android:backgroundTint="#ef5e31"
            android:layout_marginStart="8dp"
            app:cornerRadius="12dp"
            android:fontFamily="@font/neo_sans_bold_italic"/>
    </LinearLayout>
</LinearLayout>