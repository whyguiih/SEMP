<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_input_glass">

    <TextView
        android:id="@+id/tvPedidoNome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:fontFamily="@font/neo_sans_bold_italic"/>

    <TextView
        android:id="@+id/tvPedidoUnidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E0E0E0"
        android:textSize="15sp"
        android:fontFamily="@font/neo_sans_regular"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/tvPedidoProdutos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFD700"
        android:fontFamily="@font/neo_sans_medium_italic"
        android:textSize="15sp"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/tvPedidoPrioridade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#EF9A9A"
        android:fontFamily="@font/neo_sans_medium"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/tvPedidoMotivo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#CCCCCC"
        android:fontFamily="@font/neo_sans_regular"
        android:textSize="14sp"
        android:layout_marginTop="4dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnAutorizar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:text="Autorizar"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/neo_sans_bold_italic"
            android:backgroundTint="#4CAF50"
            app:cornerRadius="50dp"/>

        <Button
            android:id="@+id/btnRecusar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="50dp"
            android:text="Recusar"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/neo_sans_bold_italic"
            android:backgroundTint="#F44336"
            android:layout_marginStart="12dp"
            app:cornerRadius="50dp"/>
    </LinearLayout>
</LinearLayout>