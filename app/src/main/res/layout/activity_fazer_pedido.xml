<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainContentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVoltarCarrinho"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Finalizar Pedido"
            android:textColor="@android:color/white"
            android:fontFamily="@font/neo_sans_bold_italic"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_marginEnd="48dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="24dp"
                android:background="@drawable/bg_glass"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detalhes do Empréstimo"
                    android:textColor="#333333"
                    android:fontFamily="@font/neo_sans_bold_italic"
                    android:textSize="20sp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"/>

                <EditText
                    android:id="@+id/etNomeUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:textColor="#888888"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:enabled="false"
                    android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Seu E-mail"
                    android:textColorHint="#66333333"
                    android:textColor="#333333"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:inputType="textEmailAddress"
                    android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etDataReserva"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Data da Reserva"
                    android:textColorHint="#66333333"
                    android:textColor="#333333"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:fontFamily="@font/neo_sans_regular"/>

                <Spinner
                    android:id="@+id/spinnerPrioridade"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_glass"
                    android:layout_marginBottom="16dp"
                    android:paddingHorizontal="16dp"/>

                <EditText
                    android:id="@+id/etJustificativa"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Justifique a prioridade escolhida..."
                    android:textColorHint="#66333333"
                    android:textColor="#333333"
                    android:background="@drawable/bg_input_glass"
                    android:padding="20dp"
                    android:layout_marginBottom="32dp"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:fontFamily="@font/neo_sans_regular"/>

                <Button
                    android:id="@+id/btnConfirmarEmprestimo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="CONFIRMAR PEDIDO"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#ef5e31"
                    app:cornerRadius="50dp"
                    android:fontFamily="@font/neo_sans_bold_italic"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>