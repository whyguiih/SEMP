<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutFazerPedido"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/senai_s"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Finalizar Pedido"
                android:textColor="@android:color/white"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:textSize="24sp"
                android:gravity="center"
                android:layout_marginEnd="48dp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="24dp"
                    android:background="@drawable/bg_glass"
                    android:elevation="8dp"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detalhes do Empréstimo"
                        android:textColor="#333333"
                        android:fontFamily="@font/neo_sans_bold_italic"
                        android:textSize="20sp"
                        android:layout_marginBottom="24dp"
                        android:gravity="center"/>

                    <EditText
                        android:id="@+id/etNomeUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:textColor="#888888"
                        android:background="@drawable/bg_input_glass"
                        android:paddingHorizontal="20dp"
                        android:layout_marginBottom="16dp"
                        android:enabled="false"
                        android:fontFamily="@font/neo_sans_regular"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <EditText
                            android:id="@+id/etCodigoPedido"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:hint="Código do Pedido"
                            android:textColorHint="#66333333"
                            android:textColor="#333333"
                            android:background="@drawable/bg_input_glass"
                            android:paddingHorizontal="20dp"
                            android:enabled="false"
                            android:fontFamily="@font/neo_sans_regular"/>

                        <Button
                            android:id="@+id/btnGerarCodigoPedido"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            android:text="Gerar"
                            android:textSize="12sp"
                            android:backgroundTint="#33333333"
                            android:textColor="#333333"
                            app:cornerRadius="8dp"/>
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:hint="Seu E-mail *"
                        android:textColorHint="#66333333"
                        android:textColor="#333333"
                        android:background="@drawable/bg_input_glass"
                        android:paddingHorizontal="20dp"
                        android:layout_marginBottom="16dp"
                        android:inputType="textEmailAddress"
                        android:fontFamily="@font/neo_sans_regular"/>

                    <EditText
                        android:id="@+id/etDataReserva"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_glass"
                        android:clickable="true"
                        android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                        android:drawablePadding="12dp"
                        android:focusable="false"
                        android:fontFamily="@font/neo_sans_regular"
                        android:hint="Período da Reserva *"
                        android:paddingHorizontal="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#66333333" />

                    <Spinner
                        android:id="@+id/spinnerPrioridade"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_glass"
                        android:layout_marginBottom="16dp"
                        android:paddingHorizontal="16dp"/>

                    <EditText
                        android:id="@+id/etJustificativa"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginBottom="32dp"
                        android:background="@drawable/bg_input_glass"
                        android:fontFamily="@font/neo_sans_regular"
                        android:gravity="top"
                        android:hint="Justifique a prioridade escolhida..."
                        android:inputType="textMultiLine"
                        android:padding="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#66333333" />

                    <Button
                        android:id="@+id/btnConfirmarEmprestimo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="CONFIRMAR PEDIDO"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#ef5e31"
                        android:fontFamily="@font/neo_sans_bold_italic"
                        app:cornerRadius="100dp"/>
                </LinearLayout>

                <!-- Botão Voltar como opção secundária -->
                <Button
                    android:id="@+id/btnVoltarCarrinho"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VOLTAR AO CARRINHO"
                    android:backgroundTint="#33FFFFFF"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="32dp"
                    app:cornerRadius="100dp"/>

            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#B3000000"
        android:fitsSystemWindows="true">
        <include layout="@layout/layout_sidebar" />
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
