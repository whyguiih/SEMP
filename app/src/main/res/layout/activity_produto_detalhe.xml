<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainContentLayoutDetalhe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:id="@+id/headerDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/senai_s"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detalhes do Produto"
            android:textColor="@android:color/white"
            android:fontFamily="@font/neo_sans_bold_italic"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginEnd="48dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerDetalhe"
        app:layout_constraintBottom_toTopOf="@id/bottomBarAcoes">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:background="@drawable/bg_glass"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="28dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                app:cardCornerRadius="32dp"
                app:cardBackgroundColor="#26FFFFFF"
                app:cardElevation="0dp"
                android:layout_marginBottom="32dp">

                <ImageView
                    android:id="@+id/ivProdutoFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvNomeDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do Produto"
                android:textColor="#1a4b9f"
                android:textSize="30sp"
                android:gravity="center"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/neo_sans_bold_italic"/>

            <TextView
                android:id="@+id/tvCodigoDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/neo_sans_medium"
                android:gravity="center"
                android:letterSpacing="0.1"
                android:text="CÓDIGO DIGITAL: ---"
                android:textColor="#ffffff"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#26000000"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:id="@+id/tvEstoqueDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Disponível em estoque: 0"
                android:textColor="#ef5e31"
                android:textSize="18sp"
                android:gravity="center"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:layout_marginBottom="16dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="4"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tvCorDetalhe"
                    android:layout_columnWeight="1"
                    android:text="Cor: ---"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:fontFamily="@font/neo_sans_regular"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvMarcaRefDetalhe"
                    android:layout_columnWeight="1"
                    android:text="Ref: ---"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:fontFamily="@font/neo_sans_regular"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvUniNatalDetalhe"
                    android:layout_columnWeight="1"
                    android:text="U. Natal: ---"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:fontFamily="@font/neo_sans_regular"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvUnidadeAtualDetalhe"
                    android:layout_columnWeight="1"
                    android:text="U. Atual: ---"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:fontFamily="@font/neo_sans_regular"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/AlturaDetalhe"
                    android:layout_columnWeight="1"
                    android:text="Alt: ---"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:fontFamily="@font/neo_sans_regular"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/ComprimentoDetalhe"
                    android:layout_columnWeight="1"
                    android:text="Comp: ---"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:fontFamily="@font/neo_sans_regular"
                    android:layout_marginBottom="8dp"/>
            </GridLayout>

            <TextView
                android:id="@+id/PeriodoReserva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Período de Reserva: ---"
                android:textColor="#ef5e31"
                android:textSize="15sp"
                android:gravity="center"
                android:background="@drawable/bg_input_glass"
                android:backgroundTint="#0D000000"
                android:padding="12dp"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SOBRE O PRODUTO"
                android:textColor="#1a4b9f"
                android:textSize="14sp"
                android:letterSpacing="0.1"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDescDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descrição básica do produto..."
                android:textColor="#444444"
                android:textSize="16sp"
                android:fontFamily="@font/neo_sans_regular"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvDescDetalhadaDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Detalhes completos aparecerão aqui..."
                android:textColor="#666666"
                android:textSize="14sp"
                android:fontFamily="@font/neo_sans_regular"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:id="@+id/codigoFisico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CÓDIGO FÍSICO" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomBarAcoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="16dp"
        android:padding="16dp"
        android:background="@drawable/bg_glass"
        android:elevation="8dp"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_glass"
            android:gravity="center"
            android:layout_marginEnd="16dp">

            <TextView
                android:id="@+id/btnDiminuirQtd"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>

            <EditText
                android:id="@+id/tvQuantidadeSelecionada"
                android:layout_width="50dp"
                android:layout_height="match_parent"
                android:text="1"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@null"/>

            <TextView
                android:id="@+id/btnAumentarQtd"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnAdicionarCarrinho"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Adicionar ao Carrinho"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/neo_sans_bold_italic"
            android:backgroundTint="#E25A27"
            android:textAllCaps="false"
            app:cornerRadius="100dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>