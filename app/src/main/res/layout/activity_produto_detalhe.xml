<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:id="@+id/headerDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/senai_s"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detalhes do Produto"
            android:textColor="@android:color/white"
            android:fontFamily="@font/neo_sans_bold_italic"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginEnd="48dp"/>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardBackgroundColor="#4DFFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerDetalhe">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvNomeDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do Produto"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvQtdDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quantidade: 0"
                android:textColor="#E25A27"
                android:textSize="18sp"
                android:fontFamily="@font/neo_sans_medium"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvDescDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descrição detalhada do produto aparecerá aqui."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/neo_sans_regular"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>