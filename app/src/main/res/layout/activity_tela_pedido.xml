<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/bg_glass"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@android:drawable/ic_dialog_info"
            app:tint="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvMensagemSucesso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mensagem"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:fontFamily="@font/neo_sans_medium"
            android:textAlignment="center"
            android:layout_marginBottom="40dp"/>

        <Button
            android:id="@+id/btnVoltarInicio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VOLTAR AO INÍCIO"
            android:textColor="#1A4B9F"
            android:backgroundTint="#FFFFFF"
            android:fontFamily="@font/neo_sans_bold_italic"
            android:textSize="16sp"
            app:cornerRadius="100dp"/>

    </LinearLayout>
</LinearLayout>