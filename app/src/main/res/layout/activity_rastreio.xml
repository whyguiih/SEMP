<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient"
        android:padding="24dp">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/senai_s" />

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Registrar Rastreio"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/neo_sans" />
        </LinearLayout>

        <ScrollView
            android:layout_width="335dp"
            android:layout_height="529dp"
            android:layout_marginTop="16dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintVertical_bias="0.555"
            tools:layout_editor_absoluteX="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:background="@drawable/bg_glass"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="28dp">

                <AutoCompleteTextView
                    android:id="@+id/etRastreioCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_glass"
                    android:fontFamily="@font/neo_sans_regular"
                    android:hint="Pesquisar Pedido..."
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99434343"
                    android:completionThreshold="1" />

                <EditText
                    android:id="@+id/etRastreioOriginal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_glass"
                    android:fontFamily="@font/neo_sans_regular"
                    android:hint="Unidade Original"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99FFFFFF" />

                <EditText
                    android:id="@+id/etRastreioDestino"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_glass"
                    android:fontFamily="@font/neo_sans_regular"
                    android:hint="Unidade Destino"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99FFFFFF" />

                <EditText
                    android:id="@+id/etRastreioDataSaida"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_glass"
                    android:clickable="true"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:drawablePadding="12dp"
                    android:focusable="false"
                    android:fontFamily="@font/neo_sans_regular"
                    android:hint="Data de Saída"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99FFFFFF" />

                <EditText
                    android:id="@+id/etRastreioDataEntrada"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="32dp"
                    android:background="@drawable/bg_input_glass"
                    android:clickable="true"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:drawablePadding="12dp"
                    android:focusable="false"
                    android:fontFamily="@font/neo_sans_regular"
                    android:hint="Data Prevista Entrada"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#99FFFFFF" />

                <Button
                    android:id="@+id/btnConfirmarRastreio"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:backgroundTint="#1B4F9B"
                    android:fontFamily="@font/neo_sans_bold_italic"
                    android:text="Confirmar Rastreio"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="100dp" />

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#B3000000"
        android:fitsSystemWindows="true">

        <include layout="@layout/layout_sidebar" />
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
