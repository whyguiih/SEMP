<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutCadUsuario"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/senai_s" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cadastro de Usuários"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="24dp"
                android:background="@drawable/bg_glass"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dados do Novo Usuário"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="@font/neo_sans_medium"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/etNovoUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Nome de Usuário"
                    android:textColorHint="#88FFFFFF"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etNovaSenha"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Senha de Acesso"
                    android:textColorHint="#88FFFFFF"
                    android:textColor="#FFFFFF"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etNovoNivel"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Nível (0, 1, 2 ou 3)"
                    android:textColorHint="#88FFFFFF"
                    android:textColor="#FFFFFF"
                    android:inputType="number"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/etNovaUnidade"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="Unidade (Ex: SENAI - SEDE)"
                    android:textColorHint="#88FFFFFF"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/btnSalvarUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="CADASTRAR SISTEMA"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/neo_sans_bold_italic"
                    android:backgroundTint="#1B4F9B"
                    app:cornerRadius="8dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/layout_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>