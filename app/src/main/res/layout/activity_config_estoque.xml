<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutConfig"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/senai_s"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Config. Estoque"
                android:textColor="@android:color/white"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:textSize="24sp"
                android:gravity="center"
                android:layout_marginEnd="48dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:background="@drawable/bg_glass"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATUALIZAR PRODUTO"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etIdAtualizar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="ID do Registro"
                android:textColorHint="#66333333"
                android:textColor="#333333"
                android:background="@drawable/bg_input_glass"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/neo_sans_regular"/>

            <EditText
                android:id="@+id/etColuna"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Coluna (ex: nome, quant)"
                android:textColorHint="#66333333"
                android:textColor="#333333"
                android:background="@drawable/bg_input_glass"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/neo_sans_regular"/>

            <EditText
                android:id="@+id/etNovoValor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Novo Valor"
                android:textColorHint="#66333333"
                android:textColor="#333333"
                android:background="@drawable/bg_input_glass"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/neo_sans_regular"/>

            <Button
                android:id="@+id/btnAtualizar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Atualizar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1a4b9f"
                app:cornerRadius="12dp"
                android:fontFamily="@font/neo_sans_bold_italic"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4DFFFFFF"
                android:layout_marginVertical="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DELETAR PRODUTO"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etCodigoDeletar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Código do Produto"
                android:textColorHint="#66333333"
                android:textColor="#333333"
                android:background="@drawable/bg_input_glass"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/neo_sans_regular"/>

            <Button
                android:id="@+id/btnDeletar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Deletar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#ef5e31"
                app:cornerRadius="12dp"
                android:fontFamily="@font/neo_sans_bold_italic"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/navigationMenu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#B3000000"
        android:orientation="vertical"
        android:padding="24dp"
        android:fitsSystemWindows="true">

        <ImageView android:layout_width="100dp" android:layout_height="100dp" android:src="@drawable/senai_logo" android:layout_gravity="center_horizontal" android:layout_marginBottom="32dp"/>
        <TextView android:id="@+id/menuItemEstoque" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Visualizar Estoque" android:fontFamily="@font/neo_sans_medium" android:textSize="18sp" android:textColor="#ffffff" android:padding="12dp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/menuItemCarrinho" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Meu Carrinho" android:fontFamily="@font/neo_sans_medium" android:textSize="18sp" android:textColor="#ffffff" android:padding="12dp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/menuItemPedido" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fazer Pedido" android:fontFamily="@font/neo_sans_medium" android:textSize="18sp" android:textColor="#ffffff" android:padding="12dp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/menuItemConfigEstoque" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Configurar Estoque" android:fontFamily="@font/neo_sans_medium" android:textSize="18sp" android:textColor="#1a4b9f" android:padding="12dp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/menuItemAutorizar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Autorizar Pedidos" android:fontFamily="@font/neo_sans_medium" android:textSize="18sp" android:textColor="#1a4b9f" android:padding="12dp" android:background="?attr/selectableItemBackground"/>
        <TextView android:id="@+id/menuItemCadastrar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cadastrar Usuário" android:fontFamily="@font/neo_sans_medium" android:textSize="18sp" android:textColor="#1a4b9f" android:padding="12dp" android:background="?attr/selectableItemBackground"/>
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        <TextView android:id="@+id/menuItemSair" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sair" android:fontFamily="@font/neo_sans_bold_italic" android:textSize="18sp" android:textColor="#ef5e31" android:padding="12dp" android:background="?attr/selectableItemBackground"/>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>