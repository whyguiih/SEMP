<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutConfig"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/senai_s"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gerenciar Produto"
                android:textColor="@android:color/white"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_marginEnd="48dp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="24dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="28dp">

                <Button
                    android:id="@+id/btnVoltarCadastro"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="VOLTAR PARA CADASTRO"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/neo_sans_bold_italic"
                    android:backgroundTint="#33FFFFFF"
                    android:layout_marginBottom="32dp"
                    app:cornerRadius="100dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ATUALIZAR PRODUTO"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="@font/neo_sans_medium"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"/>

                <AutoCompleteTextView
                    android:id="@+id/etNomeAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:hint="Nome do Produto (Selecione na lista) *"
                    android:background="@drawable/bg_input_glass"
                    android:completionThreshold="1"
                    android:popupBackground="#E6FFFFFF"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/neo_sans_regular"/>

        <EditText
            android:id="@+id/etCodigoAtualizar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:textColorHint="#99FFFFFF"
            android:textColor="#FFFFFF"
            android:hint="Novo Código do Sistema *"
            android:background="@drawable/bg_input_glass"
            android:paddingHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etCodigoFisicoAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:hint="Novo Código Físico"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etDescricaoAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:hint="Nova Descrição"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etQuantidadeAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Nova Quantidade *"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:inputType="number"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etUnidadeAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:hint="Nova Unidade Natal"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etUniAtualAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:hint="Nova Unidade Atual"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etCorAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:hint="Nova Cor"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etMarcaAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:hint="Nova Marca/Referência"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="16dp"
                    android:fontFamily="@font/neo_sans_regular"/>

                <EditText
                    android:id="@+id/etDescDetalhadaAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:hint="Nova Descrição Detalhada"
                    android:gravity="top|start"
                    android:background="@drawable/bg_input_glass"
                    android:padding="20dp"
                    android:layout_marginBottom="24dp"
                    android:inputType="textMultiLine"
                    android:fontFamily="@font/neo_sans_regular"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="32dp">

                    <Button
                        android:id="@+id/btnSelecionarFotoAlt"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="ALTERAR FOTO"
                        android:backgroundTint="#33FFFFFF"
                        android:textColor="#FFFFFF"
                        android:fontFamily="@font/neo_sans_medium"
                        app:cornerRadius="100dp"/>

                    <ImageView
                        android:id="@+id/ivPreviewFotoAlt"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="16dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_input_glass"
                        android:visibility="gone"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnAtualizar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="ATUALIZAR"
                    android:textColor="#1B4F9B"
                    android:backgroundTint="#FFFFFF"
                    android:fontFamily="@font/neo_sans_bold_italic"
                    app:cornerRadius="100dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#4DFFFFFF"
                    android:layout_marginVertical="32dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DELETAR PRODUTO"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="@font/neo_sans_medium"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"/>

                <AutoCompleteTextView
                    android:id="@+id/etNomeDeletar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Nome do Produto (Selecione na lista) *"
                    android:textColorHint="#99FFFFFF"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:paddingHorizontal="20dp"
                    android:layout_marginBottom="24dp"
                    android:completionThreshold="1"
                    android:popupBackground="#E6FFFFFF"
                    android:fontFamily="@font/neo_sans_regular"/>

                <Button
                    android:id="@+id/btnDeletar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="DELETAR"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#ef5e31"
                    android:fontFamily="@font/neo_sans_bold_italic"
                    app:cornerRadius="100dp"/>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        android:fillViewport="true"
        android:fitsSystemWindows="true">
        <include layout="@layout/layout_sidebar" />
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>