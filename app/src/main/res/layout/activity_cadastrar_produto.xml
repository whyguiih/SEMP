<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayoutCadastroProduto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/senai_s"
                android:contentDescription="Menu" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gerenciar Estoque"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/neo_sans_bold_italic"
                android:textSize="22sp"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="24dp"
                android:background="@drawable/bg_glass"
                android:padding="24dp">

                <Button
                    android:id="@+id/btnAcessarAlterarEstoque"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="🔄 ALTERAR ESTOQUE EXISTENTE"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/neo_sans_bold_italic"
                    android:backgroundTint="#33FFFFFF"
                    android:layout_marginBottom="24dp"
                    app:cornerRadius="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cadastrar Novo Produto"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/neo_sans_medium"
                    android:textSize="16sp"
                    android:layout_marginBottom="16dp"/>

                <EditText
                    android:id="@+id/etCadNome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Nome do Produto"
                    android:textColorHint="#88FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text"/>

                <EditText
                    android:id="@+id/etCadCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Código do Produto"
                    android:textColorHint="#88FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text"/>

                <EditText
                    android:id="@+id/etCadDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Descrição Curta"
                    android:textColorHint="#88FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text"/>

                <EditText
                    android:id="@+id/etCadQtd"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Quantidade Inicial"
                    android:textColorHint="#88FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="number"/>

                <EditText
                    android:id="@+id/etCadUniNatal"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Unidade Natal"
                    android:textColorHint="#88FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text"/>

                <EditText
                    android:id="@+id/etCadUniAtual"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Unidade Atual"
                    android:textColorHint="#88FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text"/>

                <EditText
                    android:id="@+id/etCadMarca"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Marca / Referência"
                    android:textColorHint="#88FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text"/>

                <EditText
                    android:id="@+id/etCadCor"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Cor"
                    android:textColorHint="#88FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text"/>

                <EditText
                    android:id="@+id/etCadDescDetalhada"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:hint="Descrição Detalhada do Produto"
                    android:textColorHint="#88FFFFFF"
                    android:background="@drawable/bg_input_glass"
                    android:textColor="#FFFFFF"
                    android:padding="16dp"
                    android:gravity="top|start"
                    android:layout_marginBottom="12dp"
                    android:inputType="textMultiLine"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <Button
                        android:id="@+id/btnSelecionarFoto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📷 SELECIONAR FOTO"
                        android:backgroundTint="#33FFFFFF"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="8dp"/>

                    <ImageView
                        android:id="@+id/ivPreviewFoto"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="16dp"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_input_glass"
                        android:visibility="gone"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSalvarProduto"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="SALVAR NOVO PRODUTO"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/neo_sans_bold_italic"
                    android:backgroundTint="#ef5e31"
                    app:cornerRadius="8dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include layout="@layout/layout_sidebar" />

</androidx.drawerlayout.widget.DrawerLayout>