<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:paddingTop="48dp"
    android:paddingBottom="24dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/senai_logo"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:id="@+id/menuItemEstoque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estoque"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/neo_sans_medium"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuItemCarrinho"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Carrinho"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/neo_sans_medium"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuItemVisualizarPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Meus Pedidos"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/neo_sans_medium"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuItemConfigEstoque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cadastrar Produto"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/neo_sans_medium"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuItemAutorizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Autorizar Pedidos"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/neo_sans_medium"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuItemConfigAcesso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cadastrar Usuário"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/neo_sans_medium"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuItemRastreio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rastreio"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/neo_sans_medium"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuItemEmprestados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Itens Emprestados"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/neo_sans_medium"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>

    <TextView
        android:id="@+id/menuItemMovimentacoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Movimentações"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:fontFamily="@font/neo_sans_medium"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/menuItemSair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sair do Sistema"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="#FF5252"
        android:fontFamily="@font/neo_sans_bold_italic"
        android:paddingVertical="24dp"
        android:paddingHorizontal="24dp"
        android:background="?attr/selectableItemBackground"/>
</LinearLayout>